{
  "name": "youtube-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube chatbot monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run start:dev --workspace=@youtube-chatbot/backend\" \"npm run dev --workspace=@youtube-chatbot/frontend\"",
    "build": "npm run build --workspaces --if-present",
    "start:backend": "npm run start --workspace=@youtube-chatbot/backend",
    "start:frontend": "npm run preview --workspace=@youtube-chatbot/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
